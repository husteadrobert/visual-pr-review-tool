#!/usr/bin/env bash
# Download the browser libraries the page uses, so the demo works without Wi-Fi.
set -euo pipefail
V="$(cd "$(dirname "$0")/.." && pwd)/vendor"
mkdir -p "$V"
cd "$V"
curl -sSL -o vue.global.prod.js   https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js
curl -sSL -o diff2html-ui.min.js  https://cdn.jsdelivr.net/npm/diff2html@3/bundles/js/diff2html-ui.min.js
curl -sSL -o diff2html.min.css    https://cdn.jsdelivr.net/npm/diff2html@3/bundles/css/diff2html.min.css
curl -sSL -o mermaid.min.js       https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js
curl -sSL -o hljs-github.min.css  https://cdn.jsdelivr.net/npm/highlight.js@11/styles/github.min.css
ls -la "$V"
